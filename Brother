name: Sync with Upstream
on:
  schedule:
    - cron: '0 0 * * *'
  workflow_dispatch:

jobs:
  sync:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v3
      - run: git config user.name "abdoulayecoumbassa74-design" && git config user.email "abdoulayecoumbassa74-design@users.noreply.github.com"
      - run: git remote add upstream https://github.com/zed-industries/zed.git || git remote set-url upstream https://github.com/zed-industries/zed.git
      - run: git fetch upstream main
      - run: git checkout main && git merge upstream/main --allow-unrelated-histories || true
      - run: git push origin main
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
